{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/session-brief.sh\"",
            "timeout": 20,
            "statusMessage": "Midiendo el estado de la flota..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__graphify-.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/guard-graph-fresh.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/guard-symbol-search.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
