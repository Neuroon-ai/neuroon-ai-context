{
  "mcpServers": {
    "serena": {
      "command": "serena",
      "args": ["start-mcp-server", "--context", "claude-code",
               "--project", "neuroon-ai-context",
               "--enable-web-dashboard", "false", "--enable-gui-log-window", "false"]
    },
    "serena-api": {
      "command": "serena",
      "args": ["start-mcp-server", "--context", "claude-code",
               "--project", "api-search-neuroon",
               "--enable-web-dashboard", "false", "--enable-gui-log-window", "false"]
    },
    "serena-app": {
      "command": "serena",
      "args": ["start-mcp-server", "--context", "claude-code",
               "--project", "app-search-neuroon",
               "--enable-web-dashboard", "false", "--enable-gui-log-window", "false"]
    },
    "serena-widget": {
      "command": "serena",
      "args": ["start-mcp-server", "--context", "claude-code",
               "--project", "app-search-widget-neuroon",
               "--enable-web-dashboard", "false", "--enable-gui-log-window", "false"]
    },
    "serena-docs": {
      "command": "serena",
      "args": ["start-mcp-server", "--context", "claude-code",
               "--project", "docs-search-widget-neuroon",
               "--enable-web-dashboard", "false", "--enable-gui-log-window", "false"]
    },
    "serena-wp": {
      "command": "serena",
      "args": ["start-mcp-server", "--context", "claude-code",
               "--project", "wordpress-plugin-neuroon-search",
               "--enable-web-dashboard", "false", "--enable-gui-log-window", "false"]
    },
    "serena-engine": {
      "command": "serena",
      "args": ["start-mcp-server", "--context", "claude-code",
               "--project", "api-search-engine",
               "--enable-web-dashboard", "false", "--enable-gui-log-window", "false"]
    },
    "graphify-api": {
      "command": "graphify-mcp",
      "args": ["workspaces/.graphify-data/api-search-neuroon/graphify-out/graph.json"]
    },
    "graphify-app": {
      "command": "graphify-mcp",
      "args": ["workspaces/.graphify-data/app-search-neuroon/graphify-out/graph.json"]
    },
    "graphify-widget": {
      "command": "graphify-mcp",
      "args": ["workspaces/.graphify-data/app-search-widget-neuroon/graphify-out/graph.json"]
    },
    "graphify-docs": {
      "command": "graphify-mcp",
      "args": ["workspaces/.graphify-data/docs-search-widget-neuroon/graphify-out/graph.json"]
    },
    "graphify-wp": {
      "command": "graphify-mcp",
      "args": ["workspaces/.graphify-data/wordpress-plugin-neuroon-search/graphify-out/graph.json"]
    },
    "graphify-engine": {
      "command": "graphify-mcp",
      "args": ["workspaces/.graphify-data/api-search-engine/graphify-out/graph.json"]
    },
    "coolify": {
      "command": "sh",
      "args": ["-c", "set -a; . \"$HOME/projects/neuroon-ai-context/.env\" 2>/dev/null; set +a; exec npx -y mcp-remote https://colify.neuroon.ai/mcp --header \"Authorization: Bearer ${COOLIFY_MCP_TOKEN}\""]
    },
    "coolify-ops": {
      "command": "sh",
      "args": ["-c", "set -a; . \"$HOME/projects/neuroon-ai-context/.env\" 2>/dev/null; set +a; exec npx -y @masonator/coolify-mcp@latest"],
      "env": {
        "COOLIFY_BASE_URL": "https://colify.neuroon.ai"
      }
    },
    "hetzner": {
      "command": "sh",
      "args": ["-c", "set -a; . \"$HOME/projects/neuroon-ai-context/.env\" 2>/dev/null; set +a; exec npx -y @lazyants/hetzner-mcp-server"]
    },
    "stripe": {
      "command": "sh",
      "args": ["-c", "set -a; . \"$HOME/projects/neuroon-ai-context/.env\" 2>/dev/null; set +a; exec npx -y mcp-remote https://mcp.stripe.com --header \"Authorization: Bearer ${STRIPE_RESTRICTED_KEY}\""]
    },
    "gcloud": {
      "command": "sh",
      "args": ["-c", "exec npx -y @google-cloud/gcloud-mcp -c \"$HOME/projects/neuroon-ai-context/tools/gcloud-mcp-allow.json\""]
    }
  }
}
